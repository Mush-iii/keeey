{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseType",
  "version": "1.0.0",
  "identifier": "com.pulsetype.desktop",
  "build": {
    "beforeDevCommand": "npm run build-dev && npm run devserver",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PulseType",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Local-first touch typing trainer",
    "longDescription": "PulseType is a local-first touch typing trainer. It tracks every keystroke, generates smart lessons that focus on your weakest keys, and stores all your data on your device only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
